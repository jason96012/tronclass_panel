#!/bin/sh
# commit-msg hook — 檢查 commit 訊息是否符合 Conventional Commits（見 CONTRIBUTING 第 6 節）。
#
# 安裝：make hooks（＝git config core.hooksPath tools/git-hooks）
# 略過：git commit --no-verify（請留給緊急情況，而且要在 PR 說明原因）
#
# 為什麼要擋：這個 repo 的歷史有一段是「ptero auto-sync <時間戳>」——
# 事後完全看不出「改了什麼、為什麼」。訊息格式是唯一能自動檢查、也最便宜的一環。
set -eu

MSG_FILE="$1"
FIRST_LINE="$(head -n 1 "$MSG_FILE" | sed 's/[[:space:]]*$//')"

# 空訊息（例如 git commit --amend 沒改）與 merge／revert：不管
[ -n "$FIRST_LINE" ] || exit 0
case "$FIRST_LINE" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

# 例外：自動同步腳本（sync-to-github.sh）產生的訊息。那是鏡像紀錄，不是人類的 commit。
case "$FIRST_LINE" in
  ptero\ auto-sync*) exit 0 ;;
esac

VALID_TYPES="feat|fix|perf|refactor|docs|test|build|ci|chore|style|revert"

if ! printf '%s' "$FIRST_LINE" | grep -Eq "^($VALID_TYPES)(\([a-z0-9_/-]+\))?!?: .+"; then
  cat >&2 <<EOF
✗ commit 訊息格式不對。

  收到：$FIRST_LINE

  格式：<type>(<scope>): <一句話說明做了什麼>
  type：feat fix perf refactor docs test build ci chore style revert

  範例：
    feat(radar): 距離探測補上三個方位探測點
    fix(api): school_block_detail 誤放進 impl 區塊（E0425）
    docs(changelog): 補 fix77 的條目

  詳見 CONTRIBUTING.md 第 6 節；緊急情況可用 git commit --no-verify。
EOF
  exit 1
fi

# 標題太長通常代表「這裡塞了不只一件事」
if [ "$(printf '%s' "$FIRST_LINE" | wc -m | tr -d ' ')" -gt 72 ]; then
  echo "✗ 標題超過 72 字元（$(printf '%s' "$FIRST_LINE" | wc -m | tr -d ' ')）：請把細節移到訊息本文。" >&2
  exit 1
fi

# 動到 src/ 卻沒提到重編譯／交付，提醒一下（不擋，只提示）
if git diff --cached --name-only 2>/dev/null | grep -q '^src/'; then
  if ! grep -qE '重編|rebuild|cargo build|preflight|打包|pack' "$MSG_FILE"; then
    echo "· 提醒：這次動到 src/，記得 make verify ＋ make pack，並在訊息裡說明要不要重編譯。" >&2
  fi
fi

exit 0
