# tronclass_rollcall 設定範例
# 執行 `tronclass_rollcall init` 產生此檔案，複製為 config.toml 並依需求修改。
# 帳號請使用 `tronclass_rollcall account add` 新增至 accounts.db。

# ─── Provider 設定 ───────────────────────────────────────────────────────────
# 每個 provider 代表一套 Tronclass 系統（學校）。
# kind 可選：tronclass / fju / tku

[providers.fju]
kind = "fju"
base_url = "https://elearn2.fju.edu.tw"

[providers.fju.api]
base_url = "https://elearn2.fju.edu.tw"
poll_interval_secs = 10
request_timeout_secs = 30

[providers.fju.radar]
default_coords = [
    [25.0373, 121.4315],  # 輔大利瑪竇 LM
]
accuracy = 35
altitude = 0

[providers.fju.brute_force]
concurrency = 200
request_delay_ms = 0
transient_failure_threshold = 50
transient_failure_ratio = 0.20
cooldown_secs = 10
max_cooldowns = 3
min_concurrency = 10

[providers.fju.qrcode]
scanner_base_url = "https://elearn2.fju.edu.tw/scanner-jumper"
scan_timeout_secs = 60

[providers.fju.schedule]
periods = ["07:10~17:30"]
rest_weekdays = ["sun"]

# ─── Adapter 設定 ────────────────────────────────────────────────────────────

[adapters.line_bot]
enabled = false
channel_secret = "your_line_channel_secret"
channel_access_token = "your_line_channel_access_token"
webhook_port = 8080
webhook_path = "/webhook"
# 外部可連線的 webhook/scanner base URL，例如 ngrok 或反向代理網域。
# 設定後 QR Code 通知會開啟本機 scanner，讓一次掃描可回傳給同一 rollcall 的多帳號。
public_base_url = ""
admin_user_id = "Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

[adapters.discord]
enabled = false
bot_token = "your_discord_bot_token"
admin_user_id = "123456789012345678"
admin_channel_id = "123456789012345678"
# 外部可連線的 scanner base URL；Discord-only 部署若要使用本機 scanner 請設定。
public_base_url = ""
# 啟動時註冊 slash commands；guild_ids 留空時註冊 global commands。
register_commands = true
guild_ids = []

# ─── 時區設定 ────────────────────────────────────────────────────────────────

[time]
timezone = "Asia/Taipei"

# ─── 學期判定設定 ────────────────────────────────────────────────────────────

[semester]
# 手動覆蓋「當前學期」（選填）。未設定或留空＝依台北日期自動推算
# （8 月起為上學期、2 月起為下學期）。
# 支援格式："1151"、"115-2"、"115上"、"115下"、"2026-1"、"2026 Fall"、"2025 Spring"
# 同時影響：作業頁學期過濾、課程學期判定、淡江課表同步 YrSem。
# 使用時機例：跨學期交界學校資料尚未更新、學校學期編碼與日期推算不一致。
# 也可在網頁「設定」頁即時覆蓋（優先於此值，重啟後退回此設定）。
#current = "1151"

# ─── 作業截止追蹤設定 ────────────────────────────────────────────────────────

[homework]
# 嚴格模式（預設 true）：「無法判定為當前學期」的作業不顯示——沒有截止時間、
# 且所屬課程無法判定為當前學期（或已判定為舊課）的項目一律隱藏。
# 設 false 回到「寧可多顯示」（無法判定＝保留）。
#strict_current_semester = true
# 測試用：放寬為包含所有學期（含上學期、已逾期）的作業與測驗。
#include_all_semesters = false

# ─── 日誌設定 ────────────────────────────────────────────────────────────────

[logging]
level = "info"
log_to_file = false
log_file_path = "tronclass_rollcall.log"

# ─── 監控設定 ────────────────────────────────────────────────────────────────

[monitor]
startup_delay_secs = 3
retry_interval_secs = 30
max_failures_before_reauth = 5
